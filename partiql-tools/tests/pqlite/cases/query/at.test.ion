// `FROM e AS v AT i` binds i to each element's position (from 0) when e is a list, and to
// MISSING otherwise: a bag, or a value read as a bag of one.

{
  sql: '''
    SELECT VALUE [i, v] FROM [10, 20, 30] AS v AT i
  ''',
  expect: $bag::[ [0, 10], [1, 20], [2, 30] ]
}

{
  sql: '''
    SELECT VALUE i FROM [1, 2, 3] AT i
  ''',
  expect: $bag::[0, 1, 2]
}

{
  sql: '''
    SELECT VALUE [i, v] FROM << 1, 2 >> AS v AT i
  ''',
  expect: $bag::[ [$missing::null, 1], [$missing::null, 2] ]
}

{
  sql: '''
    SELECT VALUE [i, v] FROM {'k': 1} AS v AT i
  ''',
  expect: $bag::[ [$missing::null, { k: 1 }] ]
}

{
  sql: '''
    SELECT VALUE [i, v] FROM `[5, 6]` AS v AT i
  ''',
  expect: $bag::[ [0, 5], [1, 6] ]
}

// A subquery's rows are a bag, or a list with ORDER BY
{
  sql: '''
    SELECT VALUE [i, v] FROM (SELECT VALUE w FROM [1, 2] AS w) AS v AT i
  ''',
  expect: $bag::[ [$missing::null, 1], [$missing::null, 2] ]
}

{
  sql: '''
    SELECT VALUE [i, v] FROM (SELECT VALUE w FROM [3, 1, 2] AS w ORDER BY w) AS v AT i
  ''',
  expect: $bag::[ [0, 1], [1, 2], [2, 3] ]
}

// A variable's value, read in each row of what is to its left
{
  sql: '''
    SELECT VALUE [i, y, j] FROM [[1, 2], [3]] AS x AT i, @x AS y AT j
  ''',
  expect: $bag::[ [0, 1, 0], [0, 2, 1], [1, 3, 0] ]
}

// In WHERE and ORDER BY, and across a join
{
  sql: '''
    SELECT VALUE [i, v] FROM [10, 20, 30] AS v AT i WHERE i > 0 ORDER BY i DESC
  ''',
  expect: [ [2, 30], [1, 20] ]
}

{
  sql: '''
    SELECT VALUE [x, i, y, j] FROM ['a', 'b'] AS x AT i, [5, 6] AS y AT j WHERE i = j
  ''',
  expect: $bag::[ ["a", 0, 5, 0], ["b", 1, 6, 1] ]
}

// An outer join's padded side has a NULL position
{
  sql: '''
    SELECT VALUE [x, y, i] FROM [1, 2] AS x LEFT JOIN [2] AS y AT i ON x = y
  ''',
  expect: $bag::[ [1, null, null], [2, 2, 0] ]
}

{
  sql: '''
    SELECT VALUE [x, y, i] FROM [2] AS x AT i RIGHT JOIN [1, 2] AS y ON x = y
  ''',
  expect: $bag::[ [null, 1, null], [2, 2, 0] ]
}

{
  sql: '''
    SELECT VALUE [x, i, y, j] FROM [1, 2] AS x AT i FULL JOIN [2, 3] AS y AT j ON x = y
  ''',
  expect: $bag::[ [1, 0, null, null], [2, 1, 2, 0], [null, null, 3, 1] ]
}

// SELECT * holds every FROM variable: a position is no tuple, so it is `_1`, and a MISSING one
// has no attributes
{
  sql: '''
    SELECT * FROM [{'a': 1}, {'a': 2}] AS r AT i
  ''',
  expect: $bag::[ { a: 1, _1: 0 }, { a: 2, _1: 1 } ]
}

{
  sql: '''
    SELECT * FROM << {'a': 1} >> AS r AT i
  ''',
  expect: $bag::[ { a: 1 } ]
}

// An AT variable of the alias's name is the position
{
  sql: '''
    SELECT VALUE x FROM [5, 6] AS x AT x
  ''',
  expect: $bag::[0, 1]
}

// In GROUP BY
{
  sql: '''
    SELECT i % 2 AS k, COUNT(*) AS n FROM [1, 2, 3] AS v AT i GROUP BY i % 2
  ''',
  expect: $bag::[ { k: 0, n: 2 }, { k: 1, n: 1 } ]
}

// In a correlated subquery, the position of the row around it
{
  sql: '''
    SELECT VALUE (SELECT VALUE i * 10 + j FROM [7, 8] AS w AT j) FROM [1, 2] AS v AT i
  ''',
  expect: $bag::[ $bag::[0, 1], $bag::[10, 11] ]
}

// A table: pqlite's tables are bags
'''
CREATE TABLE t;
INSERT INTO t SELECT * FROM << {'a': 1} >>
'''

{
  sql: '''
    SELECT VALUE [i, r.a] FROM t AS r AT i
  ''',
  expect: $bag::[ [$missing::null, 1] ]
}
