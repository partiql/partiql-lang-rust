// LIMIT 0 reads nothing
{
  sql: '''
    SELECT VALUE x
    FROM << 1, 2, 3 >> x
    LIMIT 0
  ''',
  expect: $bag::[]
}

{
  sql: '''
    SELECT VALUE x
    FROM << 1, 2, 3 >> x
    LIMIT 3
  ''',
  expect: $bag::[1, 2, 3]
}

{
  sql: '''
    SELECT VALUE x
    FROM << 1, 2, 3 >> x
    LIMIT 9223372036854775807
  ''',
  expect: $bag::[1, 2, 3]
}

// LIMIT stops once its last row is out: the row after it, which fails, is never evaluated
{
  sql: '''
    SELECT VALUE x
    FROM << 1, 'a' >> x
    WHERE x + 1 > 0
    LIMIT 1
  ''',
  expect: $bag::[1]
}

{
  sql: '''
    SELECT VALUE [a, b]
    FROM << 1, 2 >> a, << 1, 'a' >> b
    WHERE b + 1 > 0
    LIMIT 1
  ''',
  expect: $bag::[
    [1, 1]
  ]
}

// OFFSET skips rows before LIMIT counts them
{
  sql: '''
    SELECT VALUE x
    FROM << 1, 2, 3, 4, 5 >> x
    ORDER BY x
    LIMIT 2 OFFSET 1
  ''',
  expect: [2, 3]
}

// The counts are expressions
{
  sql: '''
    SELECT VALUE x
    FROM << 1, 2, 3, 4, 5 >> x
    ORDER BY x
    LIMIT 4 / 2 OFFSET 2 + 1
  ''',
  expect: [4, 5]
}

// OFFSET past the end
{
  sql: '''
    SELECT VALUE x
    FROM << 1, 2, 3 >> x
    OFFSET 2147483648
  ''',
  expect: $bag::[]
}

// A count that is not a non-negative integer is ignored (strict mode: an error)
{
  sql: '''
    SELECT VALUE x
    FROM << 1, 2, 3 >> x
    ORDER BY x
    LIMIT 'a' OFFSET 1 - 2
  ''',
  expect: [1, 2, 3]
}

// An unknown count is no count
{
  sql: '''
    SELECT VALUE x
    FROM << 1, 2, 3 >> x
    ORDER BY x
    LIMIT NULL OFFSET MISSING
  ''',
  expect: [1, 2, 3]
}

// ... except a negative literal, an error in either mode
{
  sql: '''
    SELECT VALUE x
    FROM << 1, 2, 3 >> x
    OFFSET -1
  ''',
  expect: { error: "non-negative integer" }
}

// OFFSET in a correlated subquery
{
  sql: '''
    SELECT VALUE (SELECT VALUE y FROM << 1, 2, 3 >> y ORDER BY y LIMIT 1 OFFSET x)
    FROM << 0, 2, 5 >> x
  ''',
  expect: $bag::[[1], [3], []]
}
