// Aliased-reference queries that still fail for reasons unrelated to name
// resolution (their logical plans are correct). Kept `skip::` so the suite
// stays green; un-skip as the VM grows.
'''
  CREATE TABLE example;
  INSERT INTO example SELECT * FROM <<
    {'a':1,'b':4,'c':'x','d':1},
    {'a':3,'b':6,'c':'x','d':1},
    {'a':5,'b':9,'c':'y','d':2}
  >>;
  CREATE TABLE table1;
  INSERT INTO table1 SELECT * FROM <<
    {'id':1,'nodes':[{'x':10},{'x':11}]},
    {'id':2,'nodes':[{'x':20}]}
  >>;
'''

// VM: OrderBy is not compiled ("unsupported operator: Discriminant(4)").
skip::{
  sql: '''
    SELECT e.a
    FROM example e
    ORDER BY e.a DESC
  ''',
  expect: $bag::[
    { a: 5 },
    { a: 3 },
    { a: 1 }
  ]
}

// VM: SubQueryExpr in FROM / WHERE is not compiled.
skip::{
  sql: '''
    SELECT s.a
    FROM (SELECT e.a FROM example e) s
  ''',
  expect: $bag::[
    { a: 1 },
    { a: 3 },
    { a: 5 }
  ]
}

skip::{
  sql: '''
    SELECT e.a
    FROM example e
    WHERE e.a IN (SELECT VALUE t.id FROM table1 t)
  ''',
  expect: $bag::[
    { a: 1 }
  ]
}

// COUNT(*) over empty input is one row.
{
  sql: '''
    SELECT COUNT(*) AS c
    FROM example e
    WHERE e.a > 100
  ''',
  expect: $bag::[
    { c: 0 }
  ]
}

// Lowering: `e.*` (PathUnpivot) is not implemented.
skip::{
  sql: '''
    SELECT e.*
    FROM example e
  ''',
  expect: $bag::[
    { a: 1, b: 4, c: "x", d: 1 },
    { a: 3, b: 6, c: "x", d: 1 },
    { a: 5, b: 9, c: "y", d: 2 }
  ]
}
