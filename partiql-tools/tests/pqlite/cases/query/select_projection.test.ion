// Aliased projection over inline-inserted rows.
'''
  CREATE TABLE t;
  INSERT INTO t SELECT * FROM <<
    {'id':1,'name':'alice'},
    {'id':2,'name':'bob'}
  >>;
'''

{
  sql: '''
    SELECT t.id AS user_id, t.name AS nm
    FROM t
  ''',
  expect: $bag::[
    { user_id: 1, nm: "alice" },
    { user_id: 2, nm: "bob" }
  ]
}
