// Aggregate functions over an inline bag: COUNT/SUM and GROUP BY.
{
  sql: '''
    SELECT COUNT(*) AS c, SUM(t.a) AS s
    FROM << {'a': 1}, {'a': 2}, {'a': 3} >> t
  ''',
  expect: $bag::[
    { c: 3, s: 6 }
  ]
}

// Single-group GROUP BY: one output row avoids hash-iteration-order flake
// while still exercising the aggregate path.
{
  sql: '''
    SELECT g.k AS k, COUNT(*) AS n
    FROM << {'k':'x'}, {'k':'x'}, {'k':'x'} >> g
    GROUP BY g.k
  ''',
  expect: $bag::[
    { k: "x", n: 3 }
  ]
}

// An aggregate's argument reads the input row, not the GROUP BY key of the same name.
{
  sql: '''
    SELECT c, SUM(c) AS s
    FROM << {'c': 1}, {'c': 1}, {'c': 2} >> e
    GROUP BY c
  ''',
  expect: $bag::[
    { c: 1, s: 2 },
    { c: 2, s: 2 }
  ]
}

// HAVING filters groups
{
  sql: '''
    SELECT COUNT(*) AS n
    FROM << {'k':'x'}, {'k':'y'}, {'k':'y'} >> g
    GROUP BY g.k
    HAVING COUNT(*) > 1
  ''',
  expect: $bag::[
    { n: 2 }
  ]
}

// LIMIT counts groups
{
  sql: '''
    SELECT COUNT(*) AS n
    FROM << {'k':'x'}, {'k':'y'} >> g
    GROUP BY g.k
    LIMIT 1
  ''',
  expect: $bag::[
    { n: 1 }
  ]
}
{
  sql: '''
    SELECT COUNT(*) AS n
    FROM << {'k':'x'}, {'k':'y'} >> g
    GROUP BY g.k
    LIMIT 0
  ''',
  expect: $bag::[]
}

// Without GROUP BY, empty input is still one group: one row
{
  sql: '''
    SELECT COUNT(*) AS c, COUNT(t.a) AS ca, SUM(t.a) AS s, MIN(t.a) AS mn,
           MAX(t.a) AS mx, AVG(t.a) AS av
    FROM <<>> t
  ''',
  expect: $bag::[
    { c: 0, ca: 0, s: null, mn: null, mx: null, av: null }
  ]
}
{
  sql: '''
    SELECT COUNT(*) AS c
    FROM << {'a': 1} >> t
    WHERE t.a > 1
  ''',
  expect: $bag::[
    { c: 0 }
  ]
}
// With GROUP BY, empty input has no groups
{
  sql: '''
    SELECT t.k AS k, COUNT(*) AS c
    FROM <<>> t
    GROUP BY t.k
  ''',
  expect: $bag::[]
}

// NULL and MISSING keys are one group, keyed NULL
{
  sql: '''
    SELECT k, COUNT(*) AS c
    FROM << {'k': 1}, {'k': null}, {'x': 2}, {'k': null} >> t
    GROUP BY t.k AS k
  ''',
  expect: $bag::[
    { k: null, c: 3 },
    { k: 1, c: 1 }
  ]
}
{
  sql: '''
    SELECT k, COUNT(*) AS c
    FROM << {'x': 1}, {'x': 2} >> t
    GROUP BY t.k AS k
  ''',
  expect: $bag::[
    { k: null, c: 2 }
  ]
}

// A MISSING key is NULL, but a nested MISSING is not a nested NULL (spec 11.1, 7.1.1).
// Table data can't hold a nested MISSING, so the input is a literal.
{
  sql: '''
    SELECT t.l AS l, COUNT(*) AS c
    FROM << {'l': [NULL]}, {'l': [MISSING]}, {'l': [NULL]}, {'l': MISSING}, {'l': NULL} >> AS t
    GROUP BY t.l
  ''',
  expect: $bag::[
    { l: null, c: 2 },
    { l: [$missing::null], c: 1 },
    { l: [null], c: 2 }
  ]
}

// Collection keys group by value
{
  sql: '''
    SELECT t.l AS l, COUNT(*) AS c
    FROM << {'l': [1]}, {'l': [2]}, {'l': [1]}, {'l': {'a': 2}}, {'l': {'a': 1}}, {'l': {'a': 2}} >> t
    GROUP BY t.l
    ORDER BY t.l
  ''',
  expect: [
    { l: [1], c: 2 },
    { l: [2], c: 1 },
    { l: { a: 1 }, c: 1 },
    { l: { a: 2 }, c: 2 }
  ]
}

// SUM and AVG widen mixed numbers (an int to the other operand's type), AVG of ints is a
// decimal, and MIN and MAX order across types
{
  sql: '''
    SELECT VALUE [SUM(x), MIN(x), MAX(x), COUNT(x)]
    FROM << 1, 2.5, 3 >> x
  ''',
  expect: $bag::[
    [6.5, 1, 3, 3]
  ]
}

{
  sql: '''
    SELECT VALUE [AVG(x), MIN(x), MAX(x)]
    FROM << 1, 2 >> x
  ''',
  expect: $bag::[
    [1.50, 1, 2]
  ]
}

// AVG of decimals, by group; of only NULLs, NULL
{
  sql: '''
    SELECT k, AVG(x.p) AS a
    FROM << {'k': 1, 'p': 1.0}, {'k': 1, 'p': 2.0}, {'k': 1, 'p': 3.0}, {'k': 2, 'p': NULL} >> x
    GROUP BY x.k AS k
  ''',
  expect: $bag::[
    { k: 1, a: 2.0 },
    { k: 2, a: null }
  ]
}

// An input an aggregate can't take makes it MISSING; COUNT counts every present input, and
// MIN and MAX take any value
{
  sql: '''
    SELECT VALUE [SUM(x), AVG(x), COUNT(x), MIN(x), MAX(x)]
    FROM << 1, 'a', NULL, 3 >> x
  ''',
  expect: $bag::[
    [$missing::null, $missing::null, 3, 1, "a"]
  ]
}

// MIN and MAX of strings
{
  sql: '''
    SELECT VALUE [MIN(x), MAX(x)]
    FROM << 'b', 'a', 'c' >> x
  ''',
  expect: $bag::[
    ["a", "c"]
  ]
}

// DISTINCT in an aggregate is not supported yet: an error, not a silently wrong result
{
  sql: '''
    SELECT AVG(DISTINCT x) AS a
    FROM << 1, 1, 2 >> x
  ''',
  expect: { error: "DISTINCT" }
}

// The COLL_ functions share the same rules
{
  sql: '''
    SELECT VALUE [COLL_SUM(<<1, 2.5>>), COLL_AVG([1, 2]), COLL_MIN(<<'b', 'a'>>),
                  COLL_MAX(<<1, 'b'>>), COLL_COUNT([1, NULL, 'a']), COLL_COUNT(DISTINCT [1, 1, 2]),
                  COLL_AVG(DISTINCT [1, 1, 1, 3]), COLL_ANY(<<false, true>>),
                  COLL_EVERY(<<true, false>>)]
    FROM << 0 >> d
  ''',
  expect: $bag::[
    [3.5, 1.50, "a", "b", 2, 2, 2., true, false]
  ]
}

// ... and for an argument that is NULL, MISSING, empty or no collection
{
  sql: '''
    SELECT VALUE [COLL_SUM(NULL), COLL_SUM(MISSING), COLL_SUM(<<>>), COLL_COUNT(<<>>),
                  COLL_SUM('x'), COLL_SUM(<<1, 'a'>>), COLL_ANY(<<true, 5>>)]
    FROM << 0 >> d
  ''',
  expect: $bag::[
    [null, $missing::null, null, 0, $missing::null, $missing::null, $missing::null]
  ]
}
