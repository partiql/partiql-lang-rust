// `a[i]` is element i (from 0) of the list a; MISSING for a position outside it, an index
// that is no integer, or an a that is no list (a bag has no positions).

{
  sql: '''
    [[1, 2, 3][0], [1, 2, 3][2], [2, 4, 6][1 + 1], `[10, 20]`[1]]
  ''',
  expect: { rows: [1, 3, 6, 20] }
}

{
  sql: '''
    [[1, 2, 3][-1], [1, 2, 3][3], [1, 2, 3][1.0], [1, 2, 3][NULL], <<1, 2, 3>>[1],
     {'a': 1, 'b': 2}[1], 'abc'[0]]
  ''',
  expect: { rows: [$missing::null, $missing::null, $missing::null, $missing::null,
                   $missing::null, $missing::null, $missing::null] }
}

// On a variable, through attributes, and computed per row
{
  sql: '''
    SELECT VALUE [x.a[0], x.a[1].b, x.a[x.n]]
    FROM << {'a': [{'b': 1}, {'b': 2}], 'n': 1}, {'a': 7, 'n': 0} >> AS x
  ''',
  expect: $bag::[ [{ b: 1 }, 2, { b: 2 }], [$missing::null, $missing::null, $missing::null] ]
}

// In GROUP BY and ORDER BY
{
  sql: '''
    SELECT x[0] AS k, COUNT(*) AS n FROM << [1], [1], [2] >> AS x GROUP BY x[0]
  ''',
  expect: $bag::[ { k: 1, n: 2 }, { k: 2, n: 1 } ]
}

{
  sql: '''
    SELECT VALUE x FROM << [3], [1], [2] >> AS x ORDER BY x[0]
  ''',
  expect: [ [1], [2], [3] ]
}

// On a table's column
'''
CREATE TABLE stores;
INSERT INTO stores SELECT * FROM << {'id': 1, 'books': [{'title': 'a'}, {'title': 'b'}]} >>
'''

{
  sql: '''
    SELECT s.id, s.books[1].title FROM stores AS s
  ''',
  expect: $bag::[ { id: 1, title: "b" } ]
}
