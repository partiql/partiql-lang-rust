// ORDER BY: sorted results are lists.
'''
  CREATE TABLE products;
  INSERT INTO products SELECT * FROM <<
    {'id':1,'price':30,'supplier':2},
    {'id':2,'price':10,'supplier':null},
    {'id':3,'price':20,'supplier':1},
    {'id':4,'price':10},
    {'id':5,'price':20,'supplier':1}
  >>;
'''

{
  sql: '''
    SELECT p.id AS id
    FROM products p
    ORDER BY p.price, p.id
  ''',
  expect: [
    { id: 2 },
    { id: 4 },
    { id: 3 },
    { id: 5 },
    { id: 1 }
  ]
}
{
  sql: '''
    SELECT p.id AS id
    FROM products p
    ORDER BY p.price DESC, p.id DESC
  ''',
  expect: [
    { id: 1 },
    { id: 5 },
    { id: 3 },
    { id: 4 },
    { id: 2 }
  ]
}

// Ties keep their input order
{
  sql: '''
    SELECT p.id AS id
    FROM products p
    ORDER BY p.price
  ''',
  expect: [
    { id: 2 },
    { id: 4 },
    { id: 3 },
    { id: 5 },
    { id: 1 }
  ]
}

// NULL and MISSING are equal: last for ASC, first for DESC, unless NULLS says otherwise
{
  sql: '''
    SELECT p.id AS id
    FROM products p
    ORDER BY p.supplier, p.id
  ''',
  expect: [
    { id: 3 },
    { id: 5 },
    { id: 1 },
    { id: 2 },
    { id: 4 }
  ]
}
{
  sql: '''
    SELECT p.id AS id
    FROM products p
    ORDER BY p.supplier DESC, p.id
  ''',
  expect: [
    { id: 2 },
    { id: 4 },
    { id: 1 },
    { id: 3 },
    { id: 5 }
  ]
}
{
  sql: '''
    SELECT p.id AS id
    FROM products p
    ORDER BY p.supplier NULLS FIRST, p.id
  ''',
  expect: [
    { id: 2 },
    { id: 4 },
    { id: 3 },
    { id: 5 },
    { id: 1 }
  ]
}
{
  sql: '''
    SELECT p.id AS id
    FROM products p
    ORDER BY p.supplier DESC NULLS LAST, p.id
  ''',
  expect: [
    { id: 1 },
    { id: 3 },
    { id: 5 },
    { id: 2 },
    { id: 4 }
  ]
}

// A SELECT alias, with LIMIT
{
  sql: '''
    SELECT p.price AS cost, p.id AS id
    FROM products p
    ORDER BY cost DESC, id
    LIMIT 2
  ''',
  expect: [
    { cost: 30, id: 1 },
    { cost: 20, id: 3 }
  ]
}

// A key that is not projected; SELECT VALUE; SELECT *
{
  sql: '''
    SELECT VALUE p.id
    FROM products p
    WHERE p.price > 10
    ORDER BY p.price DESC, p.id
  ''',
  expect: [1, 3, 5]
}
{
  sql: '''
    SELECT *
    FROM << {'a': 2}, {'a': 1} >> t
    ORDER BY t.a
  ''',
  expect: [
    { a: 1 },
    { a: 2 }
  ]
}

// GROUP BY keys and aggregates
{
  sql: '''
    SELECT p.price AS price, COUNT(*) AS n
    FROM products p
    GROUP BY p.price
    ORDER BY COUNT(*) DESC, p.price
  ''',
  expect: [
    { price: 10, n: 2 },
    { price: 20, n: 2 },
    { price: 30, n: 1 }
  ]
}

// Numbers compare by value across types; other types in PartiQL's order
{
  sql: '''
    SELECT VALUE t.v
    FROM << {'v': 2.5}, {'v': 1}, {'v': 3.0}, {'v': -1}, {'v': 2} >> t
    ORDER BY t.v
  ''',
  expect: [-1, 1, 2, 2.5, 3.0]
}
{
  sql: '''
    SELECT VALUE t.v
    FROM << {'v': 'b'}, {'v': 1}, {'v': true}, {'v': [1]}, {'v': {'x': 1}}, {'v': <<1>>}, {'v': 'a'} >> t
    ORDER BY t.v
  ''',
  expect: [true, 1, "a", "b", [1], { x: 1 }, $bag::[1]]
}
{
  sql: '''
    SELECT VALUE t.v
    FROM << {'v': [1, 2]}, {'v': [1]}, {'v': [0, 5]}, {'v': [1, null]} >> t
    ORDER BY t.v
  ''',
  expect: [[0, 5], [1], [1, 2], [1, null]]
}

// A join
{
  sql: '''
    SELECT a.x AS x, b.y AS y
    FROM << {'x': 2}, {'x': 1} >> a, << {'y': 'b'}, {'y': 'a'} >> b
    ORDER BY a.x, b.y DESC
  ''',
  expect: [
    { x: 1, y: "b" },
    { x: 1, y: "a" },
    { x: 2, y: "b" },
    { x: 2, y: "a" }
  ]
}

// LEFT JOIN: the NULL-padded side sorts with NULLs
{
  sql: '''
    SELECT a.x AS x, b.y AS y
    FROM << {'x': 1}, {'x': 2} >> a LEFT JOIN << {'x': 2, 'y': 'b'} >> b ON a.x = b.x
    ORDER BY b.y NULLS FIRST
  ''',
  expect: [
    { x: 1, y: $missing::null },
    { x: 2, y: "b" }
  ]
}

// Fields read only below the sort (WHERE) or only by it
{
  sql: '''
    SELECT p.price AS price
    FROM products p
    WHERE p.supplier > 0
    ORDER BY p.id DESC
  ''',
  expect: [
    { price: 20 },
    { price: 20 },
    { price: 30 }
  ]
}

{
  sql: '''
    SELECT t.a AS a
    FROM <<>> t
    ORDER BY t.a
  ''',
  expect: []
}
