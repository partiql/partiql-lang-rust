// Empty user table renders as $bag::[] — pins the empty-scan envelope shape.
"CREATE TABLE empt"

{
  sql: '''
    SELECT *
    FROM empt
  ''',
  expect: $bag::[]
}

// Empty list, empty bag, and non-empty bag as projected column values.
{
  sql: '''
    SELECT [] AS xs, << >> AS ys, << 100, 200 >> AS zs
    FROM << {'a': 1} >> m
  ''',
  expect: $bag::[
    { xs: [], ys: $bag::[], zs: $bag::[100, 200] }
  ]
}
