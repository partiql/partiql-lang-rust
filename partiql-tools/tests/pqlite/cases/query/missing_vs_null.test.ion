// A referenced-but-absent field must render as $missing::null, not null.
// Locks in the MISSING_ANNOT branch in value_to_element.
{
  sql: '''
    SELECT VALUE m.nope
    FROM << {'a': 1} >> m
  ''',
  expect: $bag::[
    $missing::null
  ]
}

// ... while a row has no attribute whose value is MISSING (a NULL one stays)
{
  sql: '''
    SELECT m.nope AS x, NULL AS y
    FROM << {'a': 1} >> m
  ''',
  expect: $bag::[
    { y: null }
  ]
}

// NULL and MISSING side-by-side inside a list — the annotation must survive
// container recursion.
{
  sql: '''
    SELECT [NULL, m.nope] AS xs
    FROM << {'a': 1} >> m
  ''',
  expect: $bag::[
    { xs: [null, $missing::null] }
  ]
}
