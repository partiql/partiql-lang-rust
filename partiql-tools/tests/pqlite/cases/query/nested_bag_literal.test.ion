// Nested struct values survive insert and read-back.
'''
  CREATE TABLE issues;
  INSERT INTO issues SELECT * FROM <<
    {'number':1, 'author':{'login':'alice'}},
    {'number':2, 'author':{'login':'bob'}}
  >>;
'''

{
  sql: '''
    SELECT *
    FROM issues
  ''',
  expect: $bag::[
    { number: 1, author: { login: "alice" } },
    { number: 2, author: { login: "bob" } }
  ]
}
