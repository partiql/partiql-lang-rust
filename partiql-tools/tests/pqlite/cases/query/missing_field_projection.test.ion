// Field-not-present projection on a stored row: reading absent field `b` from
// a stored `{a:1}` produces MISSING at read time (persistence of MISSING itself
// isn't reachable via SQL literals today). A row has no attribute whose value is
// MISSING, so the SELECT list leaves `x` out; SELECT VALUE shows the MISSING.
'''
  CREATE TABLE t AS (SELECT * FROM << {'a': 1} >>);
'''

{
  sql: '''
    SELECT t.b AS x
    FROM t
  ''',
  expect: $bag::[ {} ]
}

{
  sql: '''
    SELECT VALUE t.b
    FROM t
  ''',
  expect: $bag::[ $missing::null ]
}
